#onetrust-banner-sdk .onetrust-vendors-list-handler { cursor: pointer; colo=
r: rgb(31, 150, 219); font-size: inherit; font-weight: bold; text-decoratio=
n: none; margin-left: 5px; }

#onetrust-banner-sdk .onetrust-vendors-list-handler:hover { color: rgb(31, =
150, 219); }

