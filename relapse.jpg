summary::-webkit-details-marker { display: none; }

*, ::after, ::before { box-sizing: border-box; border: 0px solid; }

html { line-height: 1.15; text-size-adjust: 100%; tab-size: 4; min-height: =
-webkit-fill-available; }

body { margin: 0px; font-family: var(--font-sans); font-size: var(--_otnfkq=
1x); scrollbar-gutter: stable; }

hr { height: 0px; color: inherit; }

